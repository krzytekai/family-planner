{
  "name": "family-planner",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm --workspace @family-planner/web run dev",
    "build": "npm --workspace @family-planner/web run build",
    "preview": "npm --workspace @family-planner/web run preview",
    "lint": "npm --workspace @family-planner/web run lint",
    "test": "npm --workspace @family-planner/web run test"
  }
}
